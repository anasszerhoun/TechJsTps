doctype html
html
  head
    title User Registration
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    // ✅ Tailwind CDN
    script(src="https://cdn.tailwindcss.com")
  body(class="bg-gradient-to-r from-purple-100 via-pink-100 to-orange-100 flex items-center justify-center min-h-screen p-6")
    .container(class="bg-white p-10 rounded-2xl shadow-lg w-full max-w-sm")
      h1(class="text-2xl font-bold text-center text-purple-700 mb-6") User Registration

      form(action="/passport/register" method="POST" class="space-y-4")
        div
          label(for="username" class="block text-gray-700 font-medium mb-1") Email
          input#email(type="email" name="username" required class="w-full border border-gray-300 p-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-400 focus:border-purple-400")

        div
          label(for="password" class="block text-gray-700 font-medium mb-1") Password
          input#password(type="password" name="password" required class="w-full border border-gray-300 p-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-400 focus:border-purple-400")

        button(type="submit" class="w-full bg-purple-600 text-white py-2 rounded-lg hover:bg-purple-700 transition-colors") Register

      p(class="text-center mt-6 text-gray-600")
        | Already have an account? 
        a(href="/login" class="text-purple-600 hover:text-purple-800 font-medium hover:underline") Login here
